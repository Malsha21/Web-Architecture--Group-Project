# Copy this file to .env and fill in your own values. Never commit .env.

# Port the API listens on
PORT=3000

# Frontend addresses allowed to call this API (comma-separated, no spaces needed)
# 5500 is the VS Code Live Server port
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# Max requests per IP every 15 minutes
RATE_LIMIT_MAX=100

# Firebase Admin credentials: choose ONE option.
# Option A: path to the service-account JSON file you downloaded from Firebase
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Option B: the whole service-account JSON on a single line
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id"}
