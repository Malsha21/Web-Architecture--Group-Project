rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {

      // User කෙනෙකුට තමන්ගේ profile එක විතරක් read කරන්න පුළුවන්.
      allow read: if request.auth != null
                  && request.auth.uid == userId;

      // Profile එක create කරන්න පුළුවන්, නමුත් role එක 'student' වෙන්න ඕනේ.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.role == 'student';

      // Update කරන්න පුළුවන් profile fields විතරයි. Role, email, uid වෙනස් කරන්න බැහැ.
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['displayName', 'grade', 'language', 'updatedAt']);

      // Delete කරන්න බැහැ.
      allow delete: if false;
    }
  }
}